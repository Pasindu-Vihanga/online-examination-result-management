@startuml

' Model Classes
class AdminLog {
  - username : String
  - password : String
  - filename : String
  + getUsername()
  + getPassword()
  + getFilename()
  + setUsername()
  + setPassword()
  + setFilename()
}

class ExamAnswer {
  - studentId : String
  - examCode : String
  - questionNumber : String
  - selectedAnswer : String
  + getstudentId()
  + getExamCode()
  + getquestionNumber()
  + getselectedAnswer()
}

class StudentLog {
}

class ExamPaper {
  - title : String
  - faculty : String
  - code : String
  - duration : String
  - totalQuestions : String
  + getTitle()
  + getFaculty()
  + getCode()
  + getDuration()
  + getTotalQuestions()
}
class ExmpSession {
  - studentId : String
  - examCode : String
  - startTime : long
  - marks : int
  + getStudentId()
  + getExamCode()
  + getStartTime()
  + getMarks()
  + int generateMarks()
}
class feedbackmodel {
  - name : String
  - email : String
  - message : String
  - rating : String
  - filename : String
  + getName()
  + getEmail()
  + getMessage()
  + getRating()
  + getFilename()
  + setName()
  + setEmail()
  + setMessage()
  + setRating()
  + setFilename()
}
class Student {
  - student_name : String
  - student_password : String
  - student_email : String
  + getstudent_name()
  + getstudent_password()
  + getstudent_email()
' Method
  + boolean isValid()
}

class User {
  - username : String
  - password : String
  - email : String
  + getUsername()
  + getPassword()
  + getEmail()
  + setUsername()
  + setPassword()
  + setEmail()
' Method
  + boolean isValid()
}

User <|-- StudentLog

@enduml